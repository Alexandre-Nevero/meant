# Copy to .env.test and fill in. .env.test is gitignored (.gitignore line 5, `.env*`)
# because this is a real connection string.
#
# The database NAME must end in `_test` — lib/db-guard.ts refuses anything else, and
# playwright.config.ts asserts it before a server is started. A Neon *branch* alone is
# not enough: a branch inherits its parent's database name and would pass nothing.
#
# Create one:
#   neon branches create --name e2e
#   neon databases create --name meant_test --branch e2e
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/meant_test?sslmode=require
